// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  PHANTOM EDGE V9 — Adaptive Trend Follower                                ║
// ║  © Erwin 2026                                                              ║
// ║                                                                            ║
// ║  FIX V8 :                                                                 ║
// ║  → V8 hardcode HTF à 1H = absurde si chart = 4H                          ║
// ║  → V9 : HTF adaptatif au timeframe du chart                              ║
// ║  → ADX filtre les marchés en range (pas de trend = pas de trade)          ║
// ║  → Shorts plus stricts (BTC bias haussier = shorts doivent être sûrs)    ║
// ║                                                                            ║
// ║  LOGIQUE SIMPLE :                                                         ║
// ║  1. HTF SuperTrend + EMA = direction                                      ║
// ║  2. ADX > seuil = trend confirmé                                          ║
// ║  3. Pullback EMA sur chart courant = entrée                               ║
// ║  4. LONG si trend UP, SHORT si trend DOWN                                 ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

//@version=6
strategy("Phantom Edge V9 — Adaptive Trend", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.075,
     slippage=2, initial_capital=10000, pyramiding=0, calc_on_every_tick=false)

// ══════════════════════════════════════════════════════════════════════════════
// PARAMÈTRES
// ══════════════════════════════════════════════════════════════════════════════

grp0 = "Timeframe"
htf_mode = input.string("Auto", "HTF Mode", options=["Auto", "Manuel"], group=grp0,
     tooltip="Auto: HTF calculé x4 du chart. Manuel: choix libre.")
htf_manual = input.timeframe("240", "HTF Manuel", group=grp0,
     tooltip="Utilisé si Mode = Manuel")

grp1 = "SuperTrend (HTF — Direction)"
st_factor  = input.float(3.0, "SuperTrend Factor", step=0.5, group=grp1)
st_period  = input.int(10,    "SuperTrend ATR Period", minval=5, group=grp1)

grp2 = "EMAs (HTF — Confirmation)"
ema_fast_len = input.int(21, "EMA rapide HTF", minval=5,  group=grp2)
ema_slow_len = input.int(50, "EMA lente HTF",  minval=20, group=grp2)

grp3 = "ADX — Force du Trend"
adx_len       = input.int(14,   "ADX Period",           group=grp3)
adx_min_long  = input.float(20, "ADX min pour LONG",    step=1.0, group=grp3,
     tooltip="ADX minimum pour confirmer un trend haussier")
adx_min_short = input.float(25, "ADX min pour SHORT",   step=1.0, group=grp3,
     tooltip="Plus strict pour shorter — BTC a un biais haussier naturel")

grp4 = "Entrée Pullback (Chart courant)"
ema_pb_len  = input.int(21,    "EMA Pullback", minval=5, group=grp4)
pb_zone_pct = input.float(0.5, "Zone pullback (%)", step=0.1, group=grp4)

grp5 = "Risk Management"
atr_len     = input.int(14,    "ATR Period",              group=grp5)
sl_atr_mult = input.float(2.0, "SL (x ATR)",             step=0.25, group=grp5)
tp_rr       = input.float(2.5, "TP (x risque) si pas trailing", step=0.25, group=grp5)
use_trail   = input.bool(true, "Trailing Stop",           group=grp5)
trail_atr   = input.float(2.0, "Trail distance (x ATR)",  step=0.25, group=grp5)

grp6 = "Filtres"
max_daily   = input.int(2,     "Max Trades/Jour", minval=1, group=grp6)
use_sess    = input.bool(true, "Session Filter",   group=grp6)
sess_open   = input.int(7,     "Open (UTC)",       group=grp6)
sess_close  = input.int(21,    "Close (UTC)",      group=grp6)

// ══════════════════════════════════════════════════════════════════════════════
// HTF ADAPTATIF
// Règle : HTF = environ 4x le timeframe du chart
// 5m → 15m (x3), 15m → 1H (x4), 1H → 4H (x4), 4H → 1D (x6)
// ══════════════════════════════════════════════════════════════════════════════

chart_tf_mins = timeframe.in_seconds() / 60

// Calcul auto du HTF
auto_htf = chart_tf_mins <= 5   ? "15"  :    // 1m-5m   → 15m
           chart_tf_mins <= 15  ? "60"  :    // 15m     → 1H
           chart_tf_mins <= 60  ? "240" :    // 1H      → 4H
           chart_tf_mins <= 240 ? "D"   :    // 4H      → Daily
           chart_tf_mins <= 1440 ? "W"  :    // Daily   → Weekly
           "M"                                // Weekly+ → Monthly

htf = htf_mode == "Auto" ? auto_htf : htf_manual

// ══════════════════════════════════════════════════════════════════════════════
// SUPERTREND HTF (Direction principale)
// ══════════════════════════════════════════════════════════════════════════════

[st_value_htf, st_dir_htf] = request.security(syminfo.tickerid, htf, ta.supertrend(st_factor, st_period), lookahead=barmerge.lookahead_off)

st_bull = st_dir_htf < 0   // SuperTrend bullish
st_bear = st_dir_htf > 0   // SuperTrend bearish

// ══════════════════════════════════════════════════════════════════════════════
// EMAs HTF (Confirmation)
// ══════════════════════════════════════════════════════════════════════════════

ema_f_htf = request.security(syminfo.tickerid, htf, ta.ema(close, ema_fast_len), lookahead=barmerge.lookahead_off)
ema_s_htf = request.security(syminfo.tickerid, htf, ta.ema(close, ema_slow_len), lookahead=barmerge.lookahead_off)

ema_bull = ema_f_htf > ema_s_htf
ema_bear = ema_f_htf < ema_s_htf

// ══════════════════════════════════════════════════════════════════════════════
// ADX — Mesure de la FORCE du trend
// ADX > 20 = trend existe, ADX > 25 = trend fort
// ADX < 20 = range → PAS DE TRADE
// ══════════════════════════════════════════════════════════════════════════════

// Calcul ADX sur le HTF pour avoir la force du trend principal
f_adx(len) =>
    up   = ta.change(high)
    down = -ta.change(low)
    plus_dm  = na(up) ? na : (up > down and up > 0 ? up : 0)
    minus_dm = na(down) ? na : (down > up and down > 0 ? down : 0)
    true_range = ta.rma(ta.tr, len)
    plus_di  = 100 * ta.rma(plus_dm, len)  / true_range
    minus_di = 100 * ta.rma(minus_dm, len) / true_range
    dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)
    adx_val = ta.rma(dx, len)
    [adx_val, plus_di, minus_di]

[adx_htf_raw, di_plus_raw, di_minus_raw] = request.security(syminfo.tickerid, htf, f_adx(adx_len), lookahead=barmerge.lookahead_off)
adx_val = adx_htf_raw

// DI+ > DI- = mouvement haussier dominant, DI- > DI+ = mouvement baissier dominant
di_bull = di_plus_raw > di_minus_raw
di_bear = di_minus_raw > di_plus_raw

// ══════════════════════════════════════════════════════════════════════════════
// TREND FINAL (HTF)
// Les 3 doivent confirmer : SuperTrend + EMA + ADX
// ══════════════════════════════════════════════════════════════════════════════

trend_bull = st_bull and ema_bull and adx_val > adx_min_long  and di_bull
trend_bear = st_bear and ema_bear and adx_val > adx_min_short and di_bear

// ══════════════════════════════════════════════════════════════════════════════
// PULLBACK (Chart courant)
// ══════════════════════════════════════════════════════════════════════════════

ema_pb  = ta.ema(close, ema_pb_len)
atr_val = ta.atr(atr_len)

// Zone de pullback
pb_zone = ema_pb * pb_zone_pct / 100

// LONG pullback : prix touche EMA21 par le bas → rebond
pb_long  = low <= ema_pb + pb_zone and close > ema_pb and close > open
// SHORT pullback : prix touche EMA21 par le haut → rejet
pb_short = high >= ema_pb - pb_zone and close < ema_pb and close < open

// ══════════════════════════════════════════════════════════════════════════════
// SESSION + DAILY LIMIT
// ══════════════════════════════════════════════════════════════════════════════

hr = hour(time, "UTC")
in_session = not use_sess or (hr >= sess_open and hr < sess_close)

var int day_trades = 0
if ta.change(dayofmonth(time)) != 0
    day_trades := 0
can_trade = day_trades < max_daily
no_pos = strategy.position_size == 0

// ══════════════════════════════════════════════════════════════════════════════
// SIGNAUX
// ══════════════════════════════════════════════════════════════════════════════

final_long  = trend_bull and pb_long  and in_session and can_trade and no_pos
final_short = trend_bear and pb_short and in_session and can_trade and no_pos

// ══════════════════════════════════════════════════════════════════════════════
// GESTION DES ORDRES
// ══════════════════════════════════════════════════════════════════════════════

var float trail_long  = na
var float trail_short = na

if final_long
    float sl   = close - atr_val * sl_atr_mult
    float risk = close - sl
    if risk > 0
        day_trades += 1
        trail_long  := sl
        trail_short := na
        strategy.entry("L", strategy.long)
        if not use_trail
            strategy.exit("L_exit", "L", stop=sl, limit=close + risk * tp_rr)

if final_short
    float sl   = close + atr_val * sl_atr_mult
    float risk = sl - close
    if risk > 0
        day_trades += 1
        trail_short := sl
        trail_long  := na
        strategy.entry("S", strategy.short)
        if not use_trail
            strategy.exit("S_exit", "S", stop=sl, limit=close - risk * tp_rr)

// --- Trailing Stop ---
if use_trail and strategy.position_size > 0
    float new_trail = close - atr_val * trail_atr
    if not na(trail_long)
        trail_long := math.max(trail_long, new_trail)
        if close <= trail_long
            strategy.close("L", comment="Trail SL")
            trail_long := na

if use_trail and strategy.position_size < 0
    float new_trail = close + atr_val * trail_atr
    if not na(trail_short)
        trail_short := math.min(trail_short, new_trail)
        if close >= trail_short
            strategy.close("S", comment="Trail SL")
            trail_short := na

// --- Sortie sur trend flip ---
if strategy.position_size > 0 and st_bear
    strategy.close("L", comment="ST Flip ▼")
    trail_long := na

if strategy.position_size < 0 and st_bull
    strategy.close("S", comment="ST Flip ▲")
    trail_short := na

// ══════════════════════════════════════════════════════════════════════════════
// AFFICHAGE
// ══════════════════════════════════════════════════════════════════════════════

// SuperTrend HTF
plot(st_value_htf, "SuperTrend HTF", st_bull ? color.new(color.green, 20) : color.new(color.red, 20), linewidth=3, style=plot.style_stepline)

// EMAs HTF
plot(ema_f_htf, "EMA Fast HTF", color.new(color.aqua, 30), linewidth=2)
plot(ema_s_htf, "EMA Slow HTF", color.new(color.orange, 30), linewidth=2)

// EMA Pullback (chart courant)
plot(ema_pb, "EMA 21 Pullback", color.new(color.white, 50), linewidth=1)

// Trailing stops
plot(strategy.position_size > 0 and use_trail ? trail_long  : na, "Trail Long",  color.new(color.lime, 30), linewidth=1, style=plot.style_stepline)
plot(strategy.position_size < 0 and use_trail ? trail_short : na, "Trail Short", color.new(color.fuchsia, 30), linewidth=1, style=plot.style_stepline)

// Background trend
bgcolor(trend_bull ? color.new(color.green, 93) : trend_bear ? color.new(color.red, 93) : color.new(color.gray, 97), title="Trend BG")

// Signaux
plotshape(final_long,  title="LONG",  location=location.belowbar, style=shape.triangleup,   size=size.large, color=color.new(#00FF88, 0), text="▲ L")
plotshape(final_short, title="SHORT", location=location.abovebar, style=shape.triangledown, size=size.large, color=color.new(#FF4444, 0), text="▼ S")

// Pullback zones subtiles
plotshape(pb_long and trend_bull and not final_long,   title="PB Long",  location=location.belowbar, style=shape.circle, size=size.tiny, color=color.new(color.green, 70))
plotshape(pb_short and trend_bear and not final_short, title="PB Short", location=location.abovebar, style=shape.circle, size=size.tiny, color=color.new(color.red, 70))

// ══════════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ══════════════════════════════════════════════════════════════════════════════

if barstate.islast
    var table d = table.new(position=position.top_right, rows=10, columns=2,
         bgcolor=color.new(#0d0d1a, 5), border_width=1, border_color=color.new(#333366, 0))

    table.cell(d, 0, 0, "PE V9", bgcolor=color.new(#FF6600, 20), text_color=color.white, text_size=size.small)
    table.cell(d, 1, 0, "Adaptive Trend", bgcolor=color.new(#FF6600, 20), text_color=color.white, text_size=size.small)

    // HTF utilisé
    table.cell(d, 0, 1, "HTF", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 1, htf, text_color=color.aqua, text_size=size.small)

    // SuperTrend
    st_txt = st_bull ? "BULL ▲" : "BEAR ▼"
    st_col = st_bull ? color.green : color.red
    table.cell(d, 0, 2, "SuperTrend", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 2, st_txt, text_color=st_col, text_size=size.small)

    // EMA
    ema_txt = ema_bull ? "21 > 50 ▲" : "21 < 50 ▼"
    ema_col = ema_bull ? color.green : color.red
    table.cell(d, 0, 3, "EMA HTF", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 3, ema_txt, text_color=ema_col, text_size=size.small)

    // ADX
    adx_col = adx_val > adx_min_short ? color.green : adx_val > adx_min_long ? color.yellow : color.red
    adx_status = adx_val > adx_min_short ? "FORT" : adx_val > adx_min_long ? "OK" : "FAIBLE"
    table.cell(d, 0, 4, "ADX", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 4, str.tostring(adx_val, "#.0") + " " + adx_status, text_color=adx_col, text_size=size.small)

    // DI+/DI-
    di_txt = di_bull ? "DI+ > DI- ▲" : "DI- > DI+ ▼"
    di_col = di_bull ? color.green : color.red
    table.cell(d, 0, 5, "Direction", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 5, di_txt, text_color=di_col, text_size=size.small)

    // Trend combiné
    td_txt = trend_bull ? "▲ LONG ONLY" : trend_bear ? "▼ SHORT ONLY" : "— FLAT (pas de trend)"
    td_col = trend_bull ? color.green : trend_bear ? color.red : color.gray
    table.cell(d, 0, 6, "SIGNAL", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 6, td_txt, text_color=td_col, text_size=size.small, bgcolor=color.new(td_col, 85))

    // Pullback
    pb_txt = pb_long ? "LONG ✓" : pb_short ? "SHORT ✓" : "—"
    pb_col = pb_long ? color.green : pb_short ? color.red : color.gray
    table.cell(d, 0, 7, "Pullback", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 7, pb_txt, text_color=pb_col, text_size=size.small)

    // Position
    pos_txt = strategy.position_size > 0 ? "LONG ▲" : strategy.position_size < 0 ? "SHORT ▼" : "FLAT"
    pos_col = strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray
    table.cell(d, 0, 8, "Position", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 8, pos_txt, text_color=pos_col, text_size=size.small)

    // Trades/jour
    table.cell(d, 0, 9, "Trades/Jour", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 9, str.tostring(day_trades) + "/" + str.tostring(max_daily), text_color=day_trades >= max_daily ? color.red : color.white, text_size=size.small)

// ══════════════════════════════════════════════════════════════════════════════
// ALERTES
// ══════════════════════════════════════════════════════════════════════════════

alertcondition(final_long,  title="PE V9 LONG",  message="PE V9 LONG — Trend ▲ confirmed + Pullback EMA21 | {{close}}")
alertcondition(final_short, title="PE V9 SHORT", message="PE V9 SHORT — Trend ▼ confirmed + Pullback EMA21 | {{close}}")
