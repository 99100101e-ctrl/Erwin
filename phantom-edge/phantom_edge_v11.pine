// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  PHANTOM EDGE V11 — Unified                                               ║
// ║  © Erwin 2026                                                              ║
// ║                                                                            ║
// ║  LONGS : V11 pullback (SuperTrend + EMA alignées + pullback + trail)     ║
// ║          → 4H + Daily UNIQUEMENT                                          ║
// ║  SHORTS : Phantom Short V11 (EMA 21/50 cross + ADX + BE + time stop)    ║
// ║          → Daily UNIQUEMENT                                               ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

//@version=6
strategy("Phantom Edge V11 — Unified", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.075,
     slippage=2, initial_capital=10000, pyramiding=0, calc_on_every_tick=false)

// ══════════════════════════════════════════════════════════════════════════════
// DÉTECTION TIMEFRAME
// ══════════════════════════════════════════════════════════════════════════════

is_daily = timeframe.isdaily
is_4h    = timeframe.period == "240"
is_long_tf  = is_4h or is_daily    // Longs : 4H + Daily uniquement
is_short_tf = is_daily              // Shorts : Daily uniquement

// ══════════════════════════════════════════════════════════════════════════════
// PARAMÈTRES
// ══════════════════════════════════════════════════════════════════════════════

grp1 = "SuperTrend"
st_factor  = input.float(3.0, "Factor",     step=0.5, group=grp1)
st_period  = input.int(10,    "ATR Period",  minval=5, group=grp1)

grp2 = "EMAs"
ema_fast_len  = input.int(21,  "EMA rapide", minval=5,  group=grp2)
ema_slow_len  = input.int(50,  "EMA lente",  minval=20, group=grp2)
ema_macro_len = input.int(200, "EMA macro",  minval=100, group=grp2)

grp3 = "Direction"
allow_long  = input.bool(true, "Autoriser LONG (4H + Daily)",  group=grp3)
allow_short = input.bool(true, "Autoriser SHORT (Daily only)", group=grp3,
     tooltip="Les shorts utilisent la logique Phantom Short V11 et ne se déclenchent QUE sur le timeframe Daily.")

// ── LONG params ──
grp4 = "LONG — Pullback"
ema_pb_len  = input.int(21,    "EMA pullback", minval=5, group=grp4)
pb_zone_pct = input.float(0.5, "Zone (%)",     step=0.1, group=grp4)

grp5 = "LONG — Risk"
atr_len      = input.int(14,    "ATR Period",         group=grp5)
long_sl_mult = input.float(2.0, "Long SL (x ATR)",   step=0.25, group=grp5)
long_trail   = input.bool(true, "Long Trailing Stop", group=grp5)
long_trail_m = input.float(2.0, "Long Trail (x ATR)", step=0.25, group=grp5)
long_tp_rr   = input.float(3.0, "Long TP (x risque) si pas trail", step=0.25, group=grp5)
long_use_be  = input.bool(true, "Long Breakeven Stop", group=grp5)
long_be_pct  = input.float(5.0, "Long BE activation (%)", step=0.5, group=grp5)

// ── SHORT params (Phantom Short V11 — Daily only) ──
grp6 = "SHORT — Filtre ADX (Daily)"
short_use_adx = input.bool(true, "Filtre ADX actif", group=grp6)
short_adx_len = input.int(14,    "ADX Period",  group=grp6)
short_adx_min = input.float(20,  "ADX minimum", step=1.0, group=grp6)

grp7 = "SHORT — Sortie (Daily)"
short_exit_mode = input.string("EMA re-cross haussier", "Mode de sortie short",
     options=["EMA re-cross haussier", "Close au-dessus EMA rapide", "Close au-dessus EMA lente"], group=grp7)
short_exit_bars = input.int(2, "Barres consécutives", group=grp7, minval=1)

grp8 = "SHORT — Protection (Daily)"
short_use_be    = input.bool(true, "Short Breakeven Stop", group=grp8)
short_be_pct    = input.float(5.0, "Short BE activation (%)", step=0.5, group=grp8)
short_use_time  = input.bool(true, "Short Time Stop", group=grp8,
     tooltip="Si pas en profit après N barres → sort. Un bon short descend vite.")
short_time_bars = input.int(15, "Barres max sans profit", group=grp8, minval=3)

grp9 = "SHORT — Trailing (Daily)"
short_use_trail = input.bool(true, "Short Trailing Stop", group=grp9)
short_trail_act = input.float(10.0, "Activation (% profit)", step=1.0, group=grp9)
short_trail_pct = input.float(12.0, "Trail (% rebond)", step=1.0, group=grp9)

grp10 = "SHORT — Cooldown (Daily)"
short_min_bars  = input.int(10, "Min barres entre shorts", group=grp10)

grp11 = "Session"
use_sess    = input.bool(false, "Session Filter", group=grp11)
sess_open   = input.int(7,  "Open (UTC)",  group=grp11)
sess_close  = input.int(21, "Close (UTC)", group=grp11)
max_daily   = input.int(3,  "Max Trades/Jour", group=grp11)

// ══════════════════════════════════════════════════════════════════════════════
// INDICATEURS
// ══════════════════════════════════════════════════════════════════════════════

// SuperTrend (pour longs)
[st_value, st_dir] = ta.supertrend(st_factor, st_period)
st_bull = st_dir < 0
st_bear = st_dir > 0

// EMAs (partagées)
ema_f   = ta.ema(close, ema_fast_len)
ema_s   = ta.ema(close, ema_slow_len)
ema200  = ta.ema(close, ema_macro_len)

// Long : alignement EMA
ema_bull = ema_f > ema_s

// Long : pullback
ema_pb  = ta.ema(close, ema_pb_len)
pb_zone = ema_pb * pb_zone_pct / 100

atr_val = ta.atr(atr_len)

// Short : ADX + DI (utilisé seulement en daily, mais calculé partout)
[s_di_plus, s_di_minus, s_adx_val] = ta.dmi(short_adx_len, short_adx_len)

// Short : EMA cross
bearish_cross = ta.crossunder(ema_f, ema_s)
bullish_cross = ta.crossover(ema_f, ema_s)

// ══════════════════════════════════════════════════════════════════════════════
// SIGNAUX
// ══════════════════════════════════════════════════════════════════════════════

hr = hour(time, "UTC")
in_session = not use_sess or (hr >= sess_open and hr < sess_close)

var int day_trades = 0
if ta.change(dayofmonth(time)) != 0
    day_trades := 0
can_trade = day_trades < max_daily
no_pos = strategy.position_size == 0

// ── LONG : SuperTrend bull + EMA alignées + pullback (4H + Daily) ──
trend_up = st_bull and ema_bull
pb_long  = low <= ema_pb + pb_zone and close > ema_pb and close > open
long_signal = allow_long and is_long_tf and trend_up and pb_long and in_session and can_trade and no_pos

// ── SHORT : EMA 21/50 bearish cross + ADX + DI (DAILY ONLY) ──
var int short_bars_since = 999
short_bars_since += 1
short_cooldown = short_bars_since >= short_min_bars
short_cond_adx = not short_use_adx or s_adx_val >= short_adx_min
short_cond_di  = not short_use_adx or s_di_minus > s_di_plus

// ★ is_daily : les shorts ne se déclenchent JAMAIS en 4H ou autre TF
short_signal = allow_short and is_short_tf and bearish_cross and short_cond_adx and short_cond_di and short_cooldown and in_session and can_trade and no_pos

// ══════════════════════════════════════════════════════════════════════════════
// SHORT — Sortie EMA (Phantom Short V11 — Daily only)
// ══════════════════════════════════════════════════════════════════════════════

var int short_bars_above = 0
short_exit_ema = short_exit_mode == "Close au-dessus EMA lente" ? ema_s : ema_f

if short_exit_mode == "EMA re-cross haussier"
    if bullish_cross
        short_bars_above := short_exit_bars
    else
        short_bars_above := 0
else
    if close > short_exit_ema
        short_bars_above += 1
    else
        short_bars_above := 0

short_exit_signal = strategy.position_size < 0 and short_bars_above >= short_exit_bars

// ══════════════════════════════════════════════════════════════════════════════
// GESTION DES ORDRES
// ══════════════════════════════════════════════════════════════════════════════

var float trail_long  = na
var float long_entry_price = na
var bool  long_be_reached  = false

var float short_entry_price = na
var float short_lowest      = na
var bool  short_be_reached  = false
var bool  short_trail_active = false
var int   short_bars_in     = 0

// ── Fermer long sur flip SuperTrend bear ──
if st_bear and strategy.position_size > 0
    strategy.close("L", comment="ST Flip ▼")
    trail_long := na
    long_be_reached := false

// ══════════════════════════════════════════════════════════════════════════════
// LONG — Pullback + Trailing (4H + Daily)
// ══════════════════════════════════════════════════════════════════════════════

if long_signal
    float sl   = close - atr_val * long_sl_mult
    float risk = close - sl
    if risk > 0
        day_trades += 1
        trail_long := sl
        long_entry_price := close
        long_be_reached  := false
        strategy.entry("L", strategy.long)
        if not long_trail
            strategy.exit("L_exit", "L", stop=sl, limit=close + risk * long_tp_rr)

// Long Breakeven
if strategy.position_size > 0 and long_use_be and not na(long_entry_price)
    float long_profit = (close - long_entry_price) / long_entry_price * 100
    if long_profit >= long_be_pct
        long_be_reached := true
    if long_be_reached and close <= long_entry_price
        strategy.close("L", comment="BE Stop L")
        trail_long := na
        long_be_reached := false

// Long Trailing
if long_trail and strategy.position_size > 0 and not na(trail_long)
    float floor_l = long_be_reached and not na(long_entry_price) ? long_entry_price : trail_long
    trail_long := math.max(floor_l, close - atr_val * long_trail_m)
    if close <= trail_long
        strategy.close("L", comment="Trail L")
        trail_long := na

// ══════════════════════════════════════════════════════════════════════════════
// SHORT — Phantom Short V11 (Daily ONLY)
// EMA cross + ADX + BE + Time Stop + Trailing
// ══════════════════════════════════════════════════════════════════════════════

if short_signal
    day_trades += 1
    short_bars_since := 0
    short_entry_price := close
    short_lowest := close
    short_be_reached := false
    short_trail_active := false
    short_bars_in := 0
    strategy.entry("S", strategy.short)

// Compteur barres en short
if strategy.position_size < 0
    short_bars_in += 1

// Short Breakeven
if strategy.position_size < 0 and short_use_be and not na(short_entry_price)
    float s_profit = (short_entry_price - close) / short_entry_price * 100
    if s_profit >= short_be_pct
        short_be_reached := true
    if short_be_reached and close >= short_entry_price
        strategy.close("S", comment="BE Stop S")

// Short Time Stop
if strategy.position_size < 0 and short_use_time and not na(short_entry_price)
    float s_profit2 = (short_entry_price - close) / short_entry_price * 100
    if short_bars_in >= short_time_bars and s_profit2 <= 0
        strategy.close("S", comment="Time Stop")

// Short Trailing
if strategy.position_size < 0 and short_use_trail and not na(short_entry_price)
    short_lowest := math.min(nz(short_lowest, close), close)
    float s_profit3 = (short_entry_price - short_lowest) / short_entry_price * 100
    if s_profit3 >= short_trail_act
        short_trail_active := true
    if short_trail_active
        float trail_level = short_lowest * (1 + short_trail_pct / 100)
        if close >= trail_level
            strategy.close("S", comment="Trail Exit S")

// Short EMA Exit
if short_exit_signal
    strategy.close("S", comment="Trend Exit S")

// Reset short vars quand flat
if strategy.position_size == 0 and na(short_entry_price) == false and strategy.position_size[1] < 0
    short_lowest := na
    short_trail_active := false
    short_be_reached := false
    short_bars_in := 0

// ══════════════════════════════════════════════════════════════════════════════
// AFFICHAGE
// ══════════════════════════════════════════════════════════════════════════════

plot(st_value, "SuperTrend", st_bull ? color.green : color.red, linewidth=3, style=plot.style_stepline)
col_ema_f = ema_f < ema_s ? color.red : color.green
plot(ema_f,   "EMA 21",  color.new(col_ema_f, 30), linewidth=2)
plot(ema_s,   "EMA 50",  color.new(color.aqua, 30),  linewidth=2)
plot(ema200,  "EMA 200", color.new(color.white, 40),  linewidth=1)

plot(strategy.position_size > 0 and long_trail ? trail_long : na, "Trail L", color.new(color.lime, 30), linewidth=1, style=plot.style_stepline)

// Zones de couleur
bgcolor(st_bull and ema_bull ? color.new(color.green, 95) : na, title="Long Zone")
bgcolor(is_short_tf and ema_f < ema_s ? color.new(color.red, 93) : na, title="Short Zone (Daily)")

// Signaux
plotshape(long_signal,  title="LONG",  location=location.belowbar, style=shape.triangleup,   size=size.large, color=#00FF88, text="▲ L")
plotshape(short_signal, title="SHORT", location=location.abovebar, style=shape.triangledown, size=size.large, color=#FF4444, text="▼ S")

// Cross short filtré (visible en daily pour debug)
plotshape(is_short_tf and bearish_cross and not short_signal and no_pos and allow_short, title="Blocked Short",
     location=location.abovebar, style=shape.xcross, size=size.small, color=color.new(color.orange, 30))

// ══════════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ══════════════════════════════════════════════════════════════════════════════

if barstate.islast
    var table d = table.new(position=position.top_right, rows=9, columns=2,
         bgcolor=color.new(#0d0d1a, 5), border_width=1, border_color=color.new(#333366, 0))

    table.cell(d, 0, 0, "PE V11", bgcolor=color.new(#FF6600, 20), text_color=color.white, text_size=size.small)
    table.cell(d, 1, 0, "Unified", bgcolor=color.new(#FF6600, 20), text_color=color.white, text_size=size.small)

    table.cell(d, 0, 1, "Timeframe", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 1, timeframe.period, text_color=color.aqua, text_size=size.small)

    table.cell(d, 0, 2, "SuperTrend", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 2, st_bull ? "BULL ▲" : "BEAR ▼", text_color=st_bull ? color.green : color.red, text_size=size.small)

    table.cell(d, 0, 3, "EMA 21/50", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 3, ema_bull ? "Bull ▲" : "Bear ▼", text_color=ema_bull ? color.green : color.red, text_size=size.small)

    long_status = not allow_long ? "OFF" : is_long_tf ? "ON" : "OFF (TF)"
    long_col = not allow_long ? color.gray : is_long_tf ? color.lime : color.orange
    table.cell(d, 0, 4, "Longs (4H+D)", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 4, long_status, text_color=long_col, text_size=size.small)

    short_status = not allow_short ? "OFF" : is_short_tf ? "ON" : "OFF (TF)"
    short_col = not allow_short ? color.gray : is_short_tf ? color.fuchsia : color.orange
    table.cell(d, 0, 5, "Shorts (D)", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 5, short_status, text_color=short_col, text_size=size.small)

    // ADX (pertinent seulement en daily)
    if is_short_tf
        table.cell(d, 0, 6, "ADX (short)", text_color=color.white, text_size=size.small)
        table.cell(d, 1, 6, str.tostring(s_adx_val, "#.0") + (s_adx_val >= short_adx_min ? " TREND" : " CHOP"),
             text_color=s_adx_val >= short_adx_min ? color.green : color.orange, text_size=size.small)
    else if is_long_tf
        table.cell(d, 0, 6, "Mode", text_color=color.white, text_size=size.small)
        table.cell(d, 1, 6, "Long Only", text_color=color.lime, text_size=size.small)
    else
        table.cell(d, 0, 6, "Mode", text_color=color.white, text_size=size.small)
        table.cell(d, 1, 6, "Inactif (TF)", text_color=color.orange, text_size=size.small)

    pos_txt = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    pos_col = strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray
    table.cell(d, 0, 7, "Position", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 7, pos_txt, text_color=pos_col, text_size=size.small)

    if strategy.position_size < 0
        table.cell(d, 0, 8, "Short bars", text_color=color.white, text_size=size.small)
        table.cell(d, 1, 8, str.tostring(short_bars_in) + "/" + str.tostring(short_time_bars),
             text_color=short_bars_in > short_time_bars * 0.7 ? color.orange : color.gray, text_size=size.small)
    else
        table.cell(d, 0, 8, "", text_color=color.white, text_size=size.small)
        table.cell(d, 1, 8, "", text_color=color.white, text_size=size.small)

// ══════════════════════════════════════════════════════════════════════════════
// ALERTES
// ══════════════════════════════════════════════════════════════════════════════

alertcondition(long_signal,  title="V11 LONG",  message="PE V11 LONG — Pullback | {{close}}")
alertcondition(short_signal, title="V11 SHORT", message="PE V11 SHORT — EMA cross (Daily) | {{close}}")

// ── Alertes enrichies (webhook Telegram / Discord) ──
if long_signal
    sl_l  = close - atr_val * long_sl_mult
    risk_l = close - sl_l
    tp_l  = close + risk_l * long_tp_rr
    alert("🟢 LONG BTC\n📍 Entry: " + str.tostring(close, "#.##") +
          "\n🛑 SL: " + str.tostring(sl_l, "#.##") +
          "\n🎯 TP: " + str.tostring(tp_l, "#.##") +
          "\n📊 TF: " + timeframe.period +
          "\n⏰ " + str.format_time(time, "yyyy-MM-dd HH:mm", syminfo.timezone),
          alert.freq_once_per_bar)

if short_signal
    alert("🔴 SHORT BTC\n📍 Entry: " + str.tostring(close, "#.##") +
          "\n📊 TF: Daily" +
          "\n📈 ADX: " + str.tostring(s_adx_val, "#.0") +
          "\n⏰ " + str.format_time(time, "yyyy-MM-dd HH:mm", syminfo.timezone),
          alert.freq_once_per_bar)
