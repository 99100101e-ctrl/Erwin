// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  PHANTOM SHORT V4 — Fixed Entries & Exits                                 ║
// ║  © Erwin 2026                                                              ║
// ║                                                                            ║
// ║  V3 : filtre daily OK (shorte en période baissière)                       ║
// ║  MAIS : les trades perdent quand même → problème d'entrée/sortie          ║
// ║                                                                            ║
// ║  V4 corrections :                                                          ║
// ║  1. Entrée plus stricte : bearish engulfing OU pin bar confirmée          ║
// ║     (pas juste "touche l'EMA")                                            ║
// ║  2. Confirmation : bougie CLÔTURÉE sous l'EMA (pas juste mèche)          ║
// ║  3. SL plus large (3x ATR) pour survivre aux bear market rallies         ║
// ║  4. TP en R:R 2:1 minimum                                                ║
// ║  5. Anti-overtrading strict : 1 trade tous les 3 jours minimum           ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

//@version=6
strategy("Phantom Short V4 — Fixed Entries", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.075,
     slippage=2, initial_capital=10000, pyramiding=0, calc_on_every_tick=false)

// ══════════════════════════════════════════════════════════════════════════════
// PARAMÈTRES
// ══════════════════════════════════════════════════════════════════════════════

grp1 = "DAILY Trend Filter"
d_ema_len     = input.int(50,   "Daily EMA Period",   group=grp1)
d_slope_bars  = input.int(10,   "Slope lookback",     group=grp1)

grp2 = "4H Entry — STRICT"
ema_fast_len  = input.int(21,   "EMA 4H rapide",       group=grp2)
ema_mid_len   = input.int(50,   "EMA 4H moyenne",      group=grp2)
entry_type    = input.string("Engulfing + EMA", "Type d'entrée",
     options=["Engulfing + EMA", "Pin Bar + EMA", "Les deux"], group=grp2,
     tooltip="Engulfing = bougie rouge qui avale la précédente à l'EMA\nPin Bar = grande mèche haute à l'EMA")
close_below   = input.bool(true, "Clôture SOUS l'EMA requise", group=grp2,
     tooltip="La bougie doit CLÔTURER sous l'EMA, pas juste la toucher avec une mèche")

grp3 = "Momentum"
rsi_len       = input.int(14,   "RSI Period", group=grp3)
rsi_max       = input.float(55, "RSI max", step=5.0, group=grp3)
rsi_min       = input.float(20, "RSI min", step=5.0, group=grp3)

grp4 = "Risk — LARGE STOPS (bear market rallies)"
atr_len       = input.int(14,    "ATR Period",     group=grp4)
sl_atr_mult   = input.float(3.0, "SL (x ATR)",     step=0.25, group=grp4,
     tooltip="SL large pour absorber les mèches et rallies. Bear markets = volatilité extrême.")
rr_ratio      = input.float(2.0, "Risk:Reward ratio", step=0.25, group=grp4,
     tooltip="TP = SL × R:R. Avec SL=3 ATR et R:R=2, TP = 6 ATR")
use_trailing   = input.bool(true, "Trailing Stop", group=grp4)
trail_atr_mult = input.float(3.0, "Trail (x ATR)", step=0.25, group=grp4)
max_bars      = input.int(40,    "Max barres",      group=grp4)

grp5 = "Anti-overtrading STRICT"
min_bars_between = input.int(18, "Min barres entre trades (18 = 3 jours en 4H)", group=grp5)

// ══════════════════════════════════════════════════════════════════════════════
// DAILY TREND (HTF)
// ══════════════════════════════════════════════════════════════════════════════

d_ema     = request.security(syminfo.tickerid, "D", ta.ema(close, d_ema_len), lookahead=barmerge.lookahead_off)
d_close   = request.security(syminfo.tickerid, "D", close, lookahead=barmerge.lookahead_off)
d_ema_old = request.security(syminfo.tickerid, "D", ta.ema(close, d_ema_len)[d_slope_bars], lookahead=barmerge.lookahead_off)

daily_bearish = d_close < d_ema and d_ema < d_ema_old

// ══════════════════════════════════════════════════════════════════════════════
// 4H INDICATORS
// ══════════════════════════════════════════════════════════════════════════════

ema_fast = ta.ema(close, ema_fast_len)
ema_mid  = ta.ema(close, ema_mid_len)
atr_val  = ta.atr(atr_len)
rsi_val  = ta.rsi(close, rsi_len)
[macd_line, signal_line, macd_hist] = ta.macd(close, 12, 26, 9)

// Structure 4H baissière
local_bearish = ema_fast < ema_mid

// ══════════════════════════════════════════════════════════════════════════════
// ENTRY PATTERNS — beaucoup plus stricts que V3
// ══════════════════════════════════════════════════════════════════════════════

// === BEARISH ENGULFING à l'EMA ===
// Bougie actuelle rouge, avale le corps de la précédente, haute touche/dépasse l'EMA
prev_green  = close[1] > open[1]
curr_red    = close < open
engulfs     = close < open[1] and open > close[1]  // corps rouge avale le vert
at_ema_eng  = high >= ema_fast * 0.997 or high >= ema_mid * 0.997  // touche l'EMA (0.3% tolérance)
bearish_engulfing = prev_green and curr_red and engulfs and at_ema_eng

// === PIN BAR (rejet) à l'EMA ===
// Grande mèche haute (>50% du range), petit corps, haute touche l'EMA
wick_up      = high - math.max(open, close)
wick_dn      = math.min(open, close) - low
body_size    = math.abs(close - open)
candle_range = high - low
at_ema_pin   = high >= ema_fast * 0.997 or high >= ema_mid * 0.997
pin_bar      = candle_range > 0 and wick_up > candle_range * 0.5 and wick_up > body_size * 2.0 and at_ema_pin

// Pattern sélectionné
pattern_ok = switch entry_type
    "Engulfing + EMA" => bearish_engulfing
    "Pin Bar + EMA"   => pin_bar
    "Les deux"        => bearish_engulfing or pin_bar

// === CLÔTURE SOUS L'EMA (confirmation) ===
close_confirmed = not close_below or (close < ema_fast and close < ema_mid)

// === PRIX VENAIT D'EN-DESSOUS (c'est un pullback UP, pas une chute continue) ===
was_lower  = low[1] < low[2] or low[2] < low[3]  // on venait de plus bas
came_up    = high > high[2]                         // on est remonté

// ══════════════════════════════════════════════════════════════════════════════
// MOMENTUM
// ══════════════════════════════════════════════════════════════════════════════

cond_rsi  = rsi_val <= rsi_max and rsi_val >= rsi_min
cond_macd = macd_line < 0

// ══════════════════════════════════════════════════════════════════════════════
// COOLDOWN
// ══════════════════════════════════════════════════════════════════════════════

var int bars_since_trade = 999
bars_since_trade += 1
cooldown_ok = bars_since_trade >= min_bars_between
no_pos = strategy.position_size == 0

// ══════════════════════════════════════════════════════════════════════════════
// SIGNAL
// ══════════════════════════════════════════════════════════════════════════════

short_signal = daily_bearish and local_bearish and pattern_ok and close_confirmed and cond_rsi and cond_macd and cooldown_ok and no_pos

// ══════════════════════════════════════════════════════════════════════════════
// ORDRES
// ══════════════════════════════════════════════════════════════════════════════

var int bars_in_trade = 0

if short_signal
    float risk    = atr_val * sl_atr_mult
    float sl_level = close + risk
    float tp_level = close - risk * rr_ratio

    bars_in_trade := 0
    bars_since_trade := 0

    strategy.entry("S", strategy.short)

    if use_trailing
        strategy.exit("S_exit", "S", stop=sl_level, limit=tp_level,
             trail_points=atr_val * trail_atr_mult / syminfo.mintick,
             trail_offset=atr_val * trail_atr_mult / syminfo.mintick)
    else
        strategy.exit("S_exit", "S", stop=sl_level, limit=tp_level)

if strategy.position_size < 0
    bars_in_trade += 1

// Timeout
if strategy.position_size < 0 and bars_in_trade >= max_bars
    strategy.close("S", comment="Timeout")

// Trend flip → sortie
if strategy.position_size < 0 and not daily_bearish
    strategy.close("S", comment="Daily Flip")

// ══════════════════════════════════════════════════════════════════════════════
// AFFICHAGE
// ══════════════════════════════════════════════════════════════════════════════

plot(ema_fast, "EMA 21",     color.new(color.yellow, 20), linewidth=1)
plot(ema_mid,  "EMA 50",     color.new(color.aqua, 20),   linewidth=2)
plot(d_ema,    "Daily EMA50", color.new(color.fuchsia, 20), linewidth=3, style=plot.style_stepline)

bgcolor(daily_bearish ? color.new(color.red, 93) : na, title="Daily Bear Zone")

// Patterns détectés (pour debug)
plotshape(bearish_engulfing and daily_bearish and not short_signal and no_pos,
     title="Engulfing", location=location.abovebar, style=shape.diamond,
     size=size.tiny, color=color.new(color.orange, 30), text="E")
plotshape(pin_bar and daily_bearish and not short_signal and no_pos,
     title="Pin", location=location.abovebar, style=shape.diamond,
     size=size.tiny, color=color.new(color.purple, 30), text="P")

// Signal SHORT
plotshape(short_signal, title="SHORT", location=location.abovebar,
     style=shape.triangledown, size=size.large, color=#FF4444, text="SHORT")

// ══════════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ══════════════════════════════════════════════════════════════════════════════

if barstate.islast
    var table d = table.new(position=position.top_right, rows=9, columns=2,
         bgcolor=color.new(#0d0d1a, 5), border_width=1, border_color=color.new(#333366, 0))

    table.cell(d, 0, 0, "PHANTOM", bgcolor=color.new(#990000, 10), text_color=color.white, text_size=size.small)
    table.cell(d, 1, 0, "SHORT V4", bgcolor=color.new(#990000, 10), text_color=color.white, text_size=size.small)

    table.cell(d, 0, 1, "Daily Trend", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 1, daily_bearish ? "BEARISH" : "NO SHORT", text_color=daily_bearish ? color.red : color.green, text_size=size.small)

    table.cell(d, 0, 2, "4H Stack", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 2, local_bearish ? "Bear" : "Bull", text_color=local_bearish ? color.red : color.green, text_size=size.small)

    table.cell(d, 0, 3, "Pattern", text_color=color.white, text_size=size.small)
    p_txt = bearish_engulfing ? "ENGULFING" : pin_bar ? "PIN BAR" : "—"
    table.cell(d, 1, 3, p_txt, text_color=pattern_ok ? color.red : color.gray, text_size=size.small)

    table.cell(d, 0, 4, "Close < EMA", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 4, close_confirmed ? "OUI" : "NON", text_color=close_confirmed ? color.red : color.gray, text_size=size.small)

    table.cell(d, 0, 5, "RSI", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 5, str.tostring(rsi_val, "#.0"), text_color=cond_rsi ? color.white : color.red, text_size=size.small)

    table.cell(d, 0, 6, "R:R", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 6, "1:" + str.tostring(rr_ratio, "#.0"), text_color=color.white, text_size=size.small)

    pos_txt = strategy.position_size < 0 ? "SHORT (" + str.tostring(bars_in_trade) + "/" + str.tostring(max_bars) + ")" : "FLAT"
    table.cell(d, 0, 7, "Position", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 7, pos_txt, text_color=strategy.position_size < 0 ? color.red : color.gray, text_size=size.small)

    table.cell(d, 0, 8, "Cooldown", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 8, cooldown_ok ? "OK" : str.tostring(min_bars_between - bars_since_trade) + " bars", text_color=cooldown_ok ? color.green : color.orange, text_size=size.small)

// ══════════════════════════════════════════════════════════════════════════════
// ALERTES
// ══════════════════════════════════════════════════════════════════════════════

alertcondition(short_signal, title="PS V4 SHORT", message="PHANTOM SHORT V4 — {{close}}")
alertcondition(daily_bearish and not daily_bearish[1], title="Bear Start", message="Daily BEARISH — shorts ON")
alertcondition(not daily_bearish and daily_bearish[1], title="Bear End", message="Daily BULLISH — shorts OFF")
