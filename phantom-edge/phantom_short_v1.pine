// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  PHANTOM SHORT V1 — Overbought Mean Reversion                             ║
// ║  © Erwin 2026                                                              ║
// ║                                                                            ║
// ║  LOGIQUE : BTC monte → excès → correction courte → on prend le profit     ║
// ║                                                                            ║
// ║  Ça marche même en bull market parce qu'on ne trade PAS le trend :         ║
// ║  on trade les EXCÈS. Même un bull market fait des pullbacks de 3-8%.       ║
// ║                                                                            ║
// ║  ENTRÉE : prix suracheté (RSI élevé + loin des EMAs + bougie rejet)       ║
// ║  SORTIE : rapide — TP fixe petit (1-2x ATR). Pas de trailing.            ║
// ║  RÈGLE D'OR : ne JAMAIS laisser courir un short sur BTC.                  ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

//@version=6
strategy("Phantom Short V1 — Overbought MR", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.075,
     slippage=2, initial_capital=10000, pyramiding=0, calc_on_every_tick=false)

// ══════════════════════════════════════════════════════════════════════════════
// PARAMÈTRES
// ══════════════════════════════════════════════════════════════════════════════

grp1 = "Overbought Detection"
rsi_len       = input.int(14,    "RSI Period",             group=grp1)
rsi_ob        = input.float(70,  "RSI Overbought",         step=1.0, group=grp1)
ema_len       = input.int(21,    "EMA référence",          group=grp1)
dist_min_pct  = input.float(2.0, "Distance min EMA (%)",   step=0.5, group=grp1,
     tooltip="Prix doit être au moins X% au-dessus de l'EMA pour shorter")

grp2 = "Confirmation"
require_rejection = input.bool(true, "Bougie de rejet requise", group=grp2,
     tooltip="Mèche haute > corps = signe de rejet")
bb_len        = input.int(20,    "Bollinger Period",        group=grp2)
bb_mult       = input.float(2.0, "Bollinger Mult",          step=0.25, group=grp2)
use_bb        = input.bool(true, "Prix doit toucher Boll supérieure", group=grp2)

grp3 = "Risk — RAPIDE (ne jamais laisser courir un short BTC)"
atr_len       = input.int(14,    "ATR Period",              group=grp3)
sl_atr_mult   = input.float(1.5, "SL (x ATR)",              step=0.25, group=grp3)
tp_atr_mult   = input.float(1.5, "TP (x ATR)",              step=0.25, group=grp3,
     tooltip="TP petit et rapide. On ne cherche pas un crash, juste le pullback.")
max_bars      = input.int(12,    "Max barres en position",   group=grp3,
     tooltip="Fermer le trade si TP pas atteint après X barres — évite de rester coincé")

grp4 = "Filtres"
max_daily     = input.int(2,  "Max Trades/Jour", group=grp4)
use_sess      = input.bool(false, "Session Filter", group=grp4)
sess_open     = input.int(7,  "Open (UTC)",  group=grp4)
sess_close    = input.int(21, "Close (UTC)", group=grp4)

// ══════════════════════════════════════════════════════════════════════════════
// INDICATEURS
// ══════════════════════════════════════════════════════════════════════════════

rsi_val = ta.rsi(close, rsi_len)
ema_ref = ta.ema(close, ema_len)
atr_val = ta.atr(atr_len)

// Distance prix vs EMA (en %)
dist_pct = (close - ema_ref) / ema_ref * 100

// Bollinger Bands
[bb_mid, bb_up, bb_dn] = ta.bb(close, bb_len, bb_mult)

// Bougie de rejet : grande mèche haute, corps petit
wick_up   = high - math.max(open, close)
body_size = math.abs(close - open)
candle_range = high - low
rejection = candle_range > 0 and wick_up > body_size and wick_up > candle_range * 0.4

// ══════════════════════════════════════════════════════════════════════════════
// CONDITIONS OVERBOUGHT
// ══════════════════════════════════════════════════════════════════════════════

// 1. RSI en zone overbought
cond_rsi = rsi_val >= rsi_ob

// 2. Prix loin au-dessus de l'EMA (surextension)
cond_dist = dist_pct >= dist_min_pct

// 3. Bougie de rejet (optionnel)
cond_reject = not require_rejection or rejection

// 4. Prix touche/dépasse Bollinger supérieure (optionnel)
cond_bb = not use_bb or high >= bb_up

// ══════════════════════════════════════════════════════════════════════════════
// SESSION + DAILY LIMIT
// ══════════════════════════════════════════════════════════════════════════════

hr = hour(time, "UTC")
in_session = not use_sess or (hr >= sess_open and hr < sess_close)

var int day_trades = 0
if ta.change(dayofmonth(time)) != 0
    day_trades := 0
can_trade = day_trades < max_daily
no_pos = strategy.position_size == 0

// ══════════════════════════════════════════════════════════════════════════════
// SIGNAL SHORT
// ══════════════════════════════════════════════════════════════════════════════

short_signal = cond_rsi and cond_dist and cond_reject and cond_bb and in_session and can_trade and no_pos

// ══════════════════════════════════════════════════════════════════════════════
// GESTION DES ORDRES
// ══════════════════════════════════════════════════════════════════════════════

var int bars_in_trade = 0

if short_signal
    float sl = close + atr_val * sl_atr_mult
    float tp = close - atr_val * tp_atr_mult
    day_trades += 1
    bars_in_trade := 0
    strategy.entry("S", strategy.short)
    strategy.exit("S_exit", "S", stop=sl, limit=tp)

// Compteur de barres en position
if strategy.position_size < 0
    bars_in_trade += 1

// Timeout : fermer si trop longtemps en position (le pullback n'est pas venu)
if strategy.position_size < 0 and bars_in_trade >= max_bars
    strategy.close("S", comment="Timeout")

// ══════════════════════════════════════════════════════════════════════════════
// AFFICHAGE
// ══════════════════════════════════════════════════════════════════════════════

plot(ema_ref, "EMA 21", color.new(color.aqua, 30), linewidth=2)
plot(bb_up,   "BB Up",  color.new(color.red, 50),  linewidth=1)
plot(bb_mid,  "BB Mid", color.new(color.gray, 60),  linewidth=1)
plot(bb_dn,   "BB Dn",  color.new(color.green, 50), linewidth=1)

// Zone overbought
bgcolor(cond_rsi and cond_dist ? color.new(color.red, 90) : na, title="Overbought Zone")

// Signaux
plotshape(short_signal, title="SHORT", location=location.abovebar, style=shape.triangledown, size=size.large, color=#FF4444, text="▼ S")

// Rejections (quand pas de signal complet)
plotshape(rejection and cond_rsi and not short_signal and no_pos, title="Reject", location=location.abovebar, style=shape.xcross, size=size.tiny, color=color.new(color.orange, 40))

// ══════════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ══════════════════════════════════════════════════════════════════════════════

if barstate.islast
    var table d = table.new(position=position.top_right, rows=7, columns=2,
         bgcolor=color.new(#0d0d1a, 5), border_width=1, border_color=color.new(#333366, 0))

    table.cell(d, 0, 0, "PHANTOM", bgcolor=color.new(#CC0000, 20), text_color=color.white, text_size=size.small)
    table.cell(d, 1, 0, "SHORT V1", bgcolor=color.new(#CC0000, 20), text_color=color.white, text_size=size.small)

    rsi_col = rsi_val >= rsi_ob ? color.red : rsi_val >= rsi_ob - 5 ? color.orange : color.white
    table.cell(d, 0, 1, "RSI", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 1, str.tostring(rsi_val, "#.0") + (cond_rsi ? " OB ✓" : ""), text_color=rsi_col, text_size=size.small)

    dist_col = cond_dist ? color.red : color.white
    table.cell(d, 0, 2, "Dist EMA", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 2, str.tostring(dist_pct, "#.1") + "%" + (cond_dist ? " ✓" : ""), text_color=dist_col, text_size=size.small)

    table.cell(d, 0, 3, "Bollinger", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 3, cond_bb ? "Touché ✓" : "—", text_color=cond_bb ? color.red : color.gray, text_size=size.small)

    table.cell(d, 0, 4, "Rejet", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 4, rejection ? "OUI ✓" : "—", text_color=rejection ? color.red : color.gray, text_size=size.small)

    pos_txt = strategy.position_size < 0 ? "SHORT (" + str.tostring(bars_in_trade) + "/" + str.tostring(max_bars) + ")" : "FLAT"
    pos_col = strategy.position_size < 0 ? color.red : color.gray
    table.cell(d, 0, 5, "Position", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 5, pos_txt, text_color=pos_col, text_size=size.small)

    table.cell(d, 0, 6, "Trades/Jour", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 6, str.tostring(day_trades) + "/" + str.tostring(max_daily), text_color=day_trades >= max_daily ? color.red : color.white, text_size=size.small)

// ══════════════════════════════════════════════════════════════════════════════
// ALERTES
// ══════════════════════════════════════════════════════════════════════════════

alertcondition(short_signal, title="PS V1 SHORT", message="PHANTOM SHORT V1 — Overbought reversal | RSI {{plot_0}} | {{close}}")
