// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  PHANTOM SHORT V6 — Trend Following (Short)                               ║
// ║  © Erwin 2026                                                              ║
// ║                                                                            ║
// ║  V1-V5 : trop de filtres, timing impossible, margin calls                 ║
// ║                                                                            ║
// ║  V6 : SIMPLE. Suivre la tendance baissière, pas la prédire.               ║
// ║                                                                            ║
// ║  ENTRÉE : EMA rapide croise sous EMA lente → short                        ║
// ║  SORTIE : prix clôture au-dessus de l'EMA rapide → close                 ║
// ║                                                                            ║
// ║  Pas de TP fixe. Pas de SL serré. On RIDE le trend.                       ║
// ║  Un trade peut durer des semaines si le trend continue.                    ║
// ║                                                                            ║
// ║  Objectif : capturer les -40% à -50% moves, accepter les petites pertes  ║
// ║  sur les faux signaux.                                                     ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

//@version=6
strategy("Phantom Short V6 — Trend Ride", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.075,
     slippage=2, initial_capital=10000, pyramiding=0, calc_on_every_tick=false)

// ══════════════════════════════════════════════════════════════════════════════
// PARAMÈTRES
// ══════════════════════════════════════════════════════════════════════════════

grp1 = "Trend EMAs"
ema_fast_len  = input.int(21,   "EMA rapide",  group=grp1)
ema_slow_len  = input.int(50,   "EMA lente",   group=grp1)

grp2 = "Entrée"
entry_mode    = input.string("EMA Cross", "Mode d'entrée",
     options=["EMA Cross", "EMA Cross + Close sous EMA lente"], group=grp2,
     tooltip="EMA Cross = entrée dès que EMA rapide croise sous lente\nAvec close = confirmation supplémentaire")

grp3 = "Sortie — LAISSER COURIR"
exit_mode     = input.string("Close au-dessus EMA rapide", "Mode de sortie",
     options=["Close au-dessus EMA rapide", "Close au-dessus EMA lente", "EMA re-cross haussier"], group=grp3,
     tooltip="Quand sortir du short. EMA rapide = plus réactif, EMA lente = reste plus longtemps")
exit_bars     = input.int(2, "Barres consécutives au-dessus pour sortir", group=grp3, minval=1,
     tooltip="Évite les fausses sorties — le prix doit rester au-dessus X barres")

grp4 = "Stop Loss de sécurité"
use_sl        = input.bool(true, "Stop Loss de sécurité", group=grp4)
sl_pct        = input.float(8.0, "SL (% au-dessus de l'entrée)", step=0.5, group=grp4,
     tooltip="SL large en pourcentage pour absorber la volatilité. 8% = raisonnable pour BTC daily")

grp5 = "Filtre anti-bull"
use_ema200    = input.bool(false, "Prix doit être sous EMA 200", group=grp5,
     tooltip="Filtre optionnel — désactivé par défaut pour ne pas rater les débuts de baisse")
ema200_len    = input.int(200, "EMA 200 Period", group=grp5)

grp6 = "Anti-overtrading"
min_bars_between = input.int(10, "Min barres entre trades", group=grp6)

// ══════════════════════════════════════════════════════════════════════════════
// INDICATEURS
// ══════════════════════════════════════════════════════════════════════════════

ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
ema_200  = ta.ema(close, ema200_len)

// Cross détection
bearish_cross = ta.crossunder(ema_fast, ema_slow)
bullish_cross = ta.crossover(ema_fast, ema_slow)

// ══════════════════════════════════════════════════════════════════════════════
// SIGNAL D'ENTRÉE — SIMPLE
// ══════════════════════════════════════════════════════════════════════════════

// Mode 1 : juste le cross
entry_cross = bearish_cross

// Mode 2 : cross + prix sous EMA lente (confirmation)
entry_confirmed = bearish_cross and close < ema_slow

entry_signal = switch entry_mode
    "EMA Cross" => entry_cross
    "EMA Cross + Close sous EMA lente" => entry_confirmed

// Filtre EMA 200 optionnel
cond_ema200 = not use_ema200 or close < ema_200

// Cooldown
var int bars_since_trade = 999
bars_since_trade += 1
cooldown_ok = bars_since_trade >= min_bars_between
no_pos = strategy.position_size == 0

// Signal final
short_signal = entry_signal and cond_ema200 and cooldown_ok and no_pos

// ══════════════════════════════════════════════════════════════════════════════
// SIGNAL DE SORTIE — LAISSER COURIR
// ══════════════════════════════════════════════════════════════════════════════

// Compter les barres consécutives au-dessus de l'EMA de sortie
var int bars_above_exit = 0

exit_ema = exit_mode == "Close au-dessus EMA lente" ? ema_slow : ema_fast

if exit_mode == "EMA re-cross haussier"
    if bullish_cross
        bars_above_exit := exit_bars  // sortie immédiate sur re-cross
    else
        bars_above_exit := 0
else
    if close > exit_ema
        bars_above_exit += 1
    else
        bars_above_exit := 0

exit_signal = strategy.position_size < 0 and bars_above_exit >= exit_bars

// ══════════════════════════════════════════════════════════════════════════════
// ORDRES
// ══════════════════════════════════════════════════════════════════════════════

var float entry_price = na

if short_signal
    bars_since_trade := 0
    entry_price := close
    strategy.entry("S", strategy.short)

    // SL de sécurité uniquement (pas de TP — on laisse courir)
    if use_sl
        float sl_level = close * (1 + sl_pct / 100)
        strategy.exit("S_sl", "S", stop=sl_level)

// Sortie sur signal
if exit_signal
    strategy.close("S", comment="Trend Exit")

// ══════════════════════════════════════════════════════════════════════════════
// AFFICHAGE
// ══════════════════════════════════════════════════════════════════════════════

// EMAs
col_fast = ema_fast < ema_slow ? color.red : color.green
plot(ema_fast, "EMA Fast", col_fast, linewidth=2)
plot(ema_slow, "EMA Slow", color.new(color.aqua, 20), linewidth=2)
plot(use_ema200 ? ema_200 : na, "EMA 200", color.new(color.white, 40), linewidth=1)

// Zone short active (EMA rapide sous lente)
bgcolor(ema_fast < ema_slow ? color.new(color.red, 93) : na, title="Bearish Zone")

// Signaux
plotshape(short_signal, title="SHORT", location=location.abovebar,
     style=shape.triangledown, size=size.large, color=#FF4444, text="SHORT")
plotshape(exit_signal, title="EXIT", location=location.belowbar,
     style=shape.triangleup, size=size.normal, color=#44FF44, text="EXIT")

// Cross markers
plotshape(bearish_cross and not short_signal, title="Bear Cross", location=location.abovebar,
     style=shape.xcross, size=size.small, color=color.new(color.red, 30))
plotshape(bullish_cross, title="Bull Cross", location=location.belowbar,
     style=shape.xcross, size=size.small, color=color.new(color.green, 30))

// PnL en cours
var label pnl_label = na
if strategy.position_size < 0 and not na(entry_price)
    pnl_pct = (entry_price - close) / entry_price * 100
    label.delete(pnl_label)
    pnl_col = pnl_pct > 0 ? color.green : color.red
    pnl_label := label.new(bar_index, high, str.tostring(pnl_pct, "#.1") + "%",
         color=color.new(pnl_col, 60), textcolor=color.white, size=size.small, style=label.style_label_down)

// ══════════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ══════════════════════════════════════════════════════════════════════════════

if barstate.islast
    var table d = table.new(position=position.top_right, rows=7, columns=2,
         bgcolor=color.new(#0d0d1a, 5), border_width=1, border_color=color.new(#333366, 0))

    table.cell(d, 0, 0, "PHANTOM", bgcolor=color.new(#990000, 10), text_color=color.white, text_size=size.small)
    table.cell(d, 1, 0, "SHORT V6", bgcolor=color.new(#990000, 10), text_color=color.white, text_size=size.small)

    // Trend
    trend_txt = ema_fast < ema_slow ? "BEARISH" : "BULLISH"
    table.cell(d, 0, 1, "Trend", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 1, trend_txt, text_color=ema_fast < ema_slow ? color.red : color.green, text_size=size.small)

    // Position
    if strategy.position_size < 0 and not na(entry_price)
        pnl = (entry_price - close) / entry_price * 100
        table.cell(d, 0, 2, "Position", text_color=color.white, text_size=size.small)
        table.cell(d, 1, 2, "SHORT " + str.tostring(pnl, "#.1") + "%", text_color=pnl > 0 ? color.green : color.red, text_size=size.small)
    else
        table.cell(d, 0, 2, "Position", text_color=color.white, text_size=size.small)
        table.cell(d, 1, 2, "FLAT", text_color=color.gray, text_size=size.small)

    // Entry price
    table.cell(d, 0, 3, "Entry", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 3, strategy.position_size < 0 ? str.tostring(entry_price, "#") : "—", text_color=color.white, text_size=size.small)

    // SL
    table.cell(d, 0, 4, "SL", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 4, use_sl ? str.tostring(sl_pct, "#.0") + "%" : "OFF", text_color=use_sl ? color.orange : color.gray, text_size=size.small)

    // Exit mode
    table.cell(d, 0, 5, "Sortie", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 5, exit_mode, text_color=color.white, text_size=size.small)

    // Bars above
    table.cell(d, 0, 6, "Bars above", text_color=color.white, text_size=size.small)
    table.cell(d, 1, 6, str.tostring(bars_above_exit) + "/" + str.tostring(exit_bars), text_color=bars_above_exit > 0 ? color.orange : color.gray, text_size=size.small)

// ══════════════════════════════════════════════════════════════════════════════
// ALERTES
// ══════════════════════════════════════════════════════════════════════════════

alertcondition(short_signal, title="V6 SHORT", message="PHANTOM SHORT V6 — Trend short | {{close}}")
alertcondition(exit_signal, title="V6 EXIT", message="PHANTOM SHORT V6 — Trend exit | {{close}}")
